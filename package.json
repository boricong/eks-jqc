{
  "name": "eks-jqc",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run documents:check && npm run typecheck && npm run build -w frontend",
    "documents:check": "node --import tsx scripts/check-documents.ts",
    "typecheck": "tsc -p server/tsconfig.json && npm run typecheck -w frontend",
    "test": "node --import tsx --test server/tests/*.test.ts",
    "test:e2e": "npm run test:e2e -w frontend",
    "data:init": "node --import tsx server/src/cli.ts init",
    "data:migrate": "node --import tsx server/src/cli.ts migrate",
    "data:migrate-administration": "node --import tsx server/src/cli.ts migrate-administration",
    "data:migrate-assessment-flow": "node --import tsx server/src/cli.ts migrate-assessment-flow",
    "data:migrate-lifecycle": "node --import tsx server/src/cli.ts migrate-lifecycle",
    "data:migrate-policies": "node --import tsx server/src/cli.ts migrate-policies",
    "data:transition-assessments": "node --import tsx server/src/cli.ts transition-assessments",
    "data:setup-photo": "node --import tsx server/src/cli.ts setup-photo",
    "data:organizations:restore": "node --import tsx server/src/cli.ts organizations:restore",
    "data:backup": "node --import tsx server/src/cli.ts backup",
    "data:recover-master": "node --import tsx server/src/cli.ts recover-master",
    "data:restore": "node --import tsx server/src/cli.ts restore",
    "data:unlock": "node --import tsx server/src/cli.ts unlock",
    "start": "node --import tsx server/src/index.ts",
    "data:migrate-catalog-editing": "node --import tsx server/src/cli.ts migrate-catalog-editing",
    "data:migrate-planning": "node --import tsx server/src/cli.ts migrate-planning",
    "data:migrate-templates": "node --import tsx server/src/cli.ts migrate-templates",
    "data:migrate-qualification-types": "node --import tsx server/src/cli.ts migrate-qualification-types",
    "data:migrate-course-types": "node --import tsx server/src/cli.ts migrate-course-types",
    "data:migrate-auditor-program": "node --import tsx server/src/cli.ts migrate-auditor-program",
    "data:migrate-auditor-workflow": "node --import tsx server/src/cli.ts migrate-auditor-workflow",
    "data:migrate-common-courses": "node --import tsx server/src/cli.ts migrate-common-courses",
    "data:migrate-ready-qualifications": "node --import tsx server/src/cli.ts migrate-ready-qualifications",
    "data:migrate-automatic-criteria": "node --import tsx server/src/cli.ts migrate-automatic-criteria",
    "data:migrate-remove-required-qualifications": "node --import tsx server/src/cli.ts migrate-remove-required-qualifications",
    "data:migrate-subjective": "node --import tsx server/src/cli.ts migrate-subjective",
    "data:migrate-organization-needs": "node --import tsx server/src/cli.ts migrate-organization-needs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
